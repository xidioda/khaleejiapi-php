{
    "name": "khaleejiapi/sdk",
    "description": "Official PHP SDK for KhaleejiAPI — MENA region developer APIs",
    "version": "1.0.0",
    "type": "library",
    "license": "MIT",
    "homepage": "https://khaleejiapi.dev",
    "keywords": ["khaleejiapi", "api", "mena", "gcc", "uae", "saudi", "validation", "fintech"],
    "authors": [
        {
            "name": "KhaleejiAPI Team",
            "email": "support@khaleejiapi.dev",
            "homepage": "https://khaleejiapi.dev"
        }
    ],
    "require": {
        "php": "^8.1",
        "guzzlehttp/guzzle": "^7.0"
    },
    "require-dev": {
        "phpunit/phpunit": "^10.0"
    },
    "autoload": {
        "psr-4": {
            "KhaleejiAPI\\": "src/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "KhaleejiAPI\\Tests\\": "tests/"
        }
    },
    "scripts": {
        "test": "phpunit"
    },
    "minimum-stability": "stable"
}
